CLASS net/minecraft/class_2415 net/minecraft/util/math/BlockMirror
	COMMENT Represents how to mirror a structure piece. Used by structure blocks and
	COMMENT other structure generation-related functionality.
	COMMENT
	COMMENT There is no value for both a left–right and front–back reflection (i.e. a
	COMMENT 180° rotation) at the same time; instead, structure blocks hold both a
	COMMENT {@link BlockMirror} value and a {@link BlockRotation} value.
	FIELD field_23263 directionTransformation Lnet/minecraft/class_4990;
	FIELD field_27883 name Lnet/minecraft/class_2561;
	FIELD field_39311 CODEC Lcom/mojang/serialization/Codec;
	FIELD field_39312 id Ljava/lang/String;
	FIELD field_56669 ENUM_NAME_CODEC Lcom/mojang/serialization/Codec;
	METHOD <init> (Ljava/lang/String;ILjava/lang/String;Lnet/minecraft/class_4990;)V
		ARG 3 id
		ARG 4 directionTransformation
	METHOD method_10343 apply (Lnet/minecraft/class_2350;)Lnet/minecraft/class_2350;
		COMMENT Applies this transformation to {@code direction}.
		ARG 1 direction
	METHOD method_10344 mirror (II)I
		COMMENT Applies this transformation to a rotation value, such as one in the block
		COMMENT state of certain blocks such as signs or banners.
		ARG 1 rotation
			COMMENT the rotation value to transform
		ARG 2 fullTurn
			COMMENT the total number of rotations possible
	METHOD method_10345 getRotation (Lnet/minecraft/class_2350;)Lnet/minecraft/class_2470;
		COMMENT Returns the {@link BlockRotation} that would send {@code direction} to
		COMMENT {@code this.apply(direction)}.
		ARG 1 direction
	METHOD method_26380 getDirectionTransformation ()Lnet/minecraft/class_4990;
		COMMENT {@return the {@link DirectionTransformation} corresponding to this transformation}
	METHOD method_32354 getName ()Lnet/minecraft/class_2561;
		COMMENT {@return the {@link Text} describing this transformation}
