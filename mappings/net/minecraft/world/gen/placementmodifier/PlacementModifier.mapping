	METHOD method_1_7563 modify (Lnet/minecraft/class_5444;Lnet/minecraft/class_5819;Lnet/minecraft/class_2338;Ljava/util/function/Consumer;)V
		ARG 1 context
		ARG 2 random
		ARG 3 pos
		ARG 4 callback
			COMMENT a callback that accepts each position generated by the modifier
